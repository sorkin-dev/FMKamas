{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FMKamas Item",
  "type": "object",
  "required": ["id", "name", "level", "type", "stats"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 200 },
    "type": {
      "type": "string",
      "enum": ["Anneau", "Amulette", "Ceinture", "Bottes", "Cape", "Chapeau", "Dagues", "Épée", "Baguette", "Arc", "Marteau", "Pelle", "Faux", "Bouclier", "Familier"]
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "min", "max"],
        "properties": {
          "type": { "type": "string" },
          "min": { "type": "integer", "minimum": 0 },
          "max": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
